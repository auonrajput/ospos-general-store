}

/* Jab dropdown open ho */
select.form-control option, 
select option,
select.custom-select option,
select.bootstrap-select option {
    color: #000000 !important;
    background-color: #f8f9fa !important;
    -webkit-text-fill-color: #000000 !important;
}

/* Focus state */
select.form-control:focus,
select:focus {
    color: #ffffff !important;
    background-color: #1a1a2e !important;
    border-color: #4ecca3 !important;
}

/* Darkly theme specific */
.theme-darkly select.form-control,
.theme-darkly select,
body.darkly select {
    color: #ffffff !important;
    background-color: #1a1a2e !important;
}
</style>




<style>

.theme-light {
    --bg-primary: #ffffff;
    --bg-secondary: #f8f9fa;
    --text-primary: #333333;
    --text-secondary: #666666;
    --border-color: #dee2e6;
    --card-bg: #ffffff;
}

.theme-dark {
    --bg-primary: #1a1a2e;
    --bg-secondary: #16213e;
    --text-primary: #ffffff;
    --text-secondary: #cccccc;
    --border-color: #4ecca3;
    --card-bg: #16213e;
}

/* Apply theme to body and containers */
.theme-light body, 
.theme-light .container, 
.theme-light .tab-content,
.theme-light .container-fluid {
    background-color: var(--bg-primary) !important;
    color: var(--text-primary) !important;
}

.theme-dark body, 
.theme-dark .container, 
.theme-dark .tab-content,
.theme-dark .container-fluid {
    background-color: var(--bg-secondary) !important;
    color: var(--text-primary) !important;
}

/* Cards and Panels */
.theme-dark .card, 
.theme-dark .panel, 
.theme-dark .tab-pane,
.theme-dark .modal-content {
    background-color: var(--card-bg) !important;
    color: var(--text-primary) !important;
    border-color: var(--border-color) !important;
}

.theme-dark .table {
    color: var(--text-primary) !important;
}

.theme-dark .table thead th {
    background-color: #0f3460 !important;
    color: #fff !important;
}

.theme-dark .table tbody td {
    border-color: #2a2a4a !important;
}

/* Form Elements */
.theme-dark input:not([type="checkbox"]):not([type="radio"]),
.theme-dark select,
.theme-dark textarea {
    background-color: #1a1a2e !important;
    color: #fff !important;
    border-color: #4ecca3 !important;
}

.theme-dark label {
    color: var(--text-secondary) !important;
}

/* Dropdowns */
.theme-dark select.form-control option,
.theme-dark select option {
    color: #000 !important;
    background-color: #f8f9fa !important;
}

.theme-light select option {
    color: #000 !important;
    background-color: #fff !important;
}

/* Buttons */
.theme-dark .btn-primary {
    background-color: #4ecca3 !important;
    border-color: #4ecca3 !important;
    color: #1a1a2e !important;
}

.theme-dark .btn-secondary {
    background-color: #2a2a4a !important;
    border-color: #2a2a4a !important;
    color: #fff !important;
}

/* Navigation */
.theme-dark .nav-tabs .nav-link {
    color: var(--text-secondary) !important;
}

.theme-dark .nav-tabs .nav-link.active {
    background-color: var(--card-bg) !important;
    color: var(--text-primary) !important;
    border-color: var(--border-color) !important;
}

/* Sidebar (if exists) */
.theme-dark .sidebar,
.theme-dark .settings-sidebar {
    background-color: #0f3460 !important;
    border-color: #2a2a4a !important;
}

/* Modals */
.theme-dark .modal-header,
.theme-dark .modal-footer {
    border-color: #2a2a4a !important;
}

/* Alerts */
.theme-dark .alert-info {
    background-color: #0f3460 !important;
    color: #fff !important;
    border-color: #4ecca3 !important;
}
</style>

