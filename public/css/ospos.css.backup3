* {
    margin: 0;
    padding: 0;
}

html,
body {
    height: 100%;
}

a.none {
    text-decoration: none;
}

.topbar {
    color: #eee;
    font-size: 12px;
    background: #182735;
    padding: 0.2em;
}

/* Add container-xxl width from Bootstrap 5 */
@media (min-width: 1400px) {
    .container {
        width: 1320px;
    }
}

.navbar {
    border-radius: 0;
}

.tab-pane {
    padding-top: 10px;
}

.navbar-default .navbar-nav>.active>a,
.navbar-default .navbar-nav>.active>a:hover,
.navbar-default .navbar-nav>.active>a:focus {
    color: #2C3E50;
    background-color: #FFFFFF;
}

.jumbotron.push-spaces {
    margin: 0; /* Add this */
}

.navbar .menu-icon {
    text-align: center;
    font-size: 12px;
}

.navbar .menu-icon img {
    width: 24px;
}

.wrapper {
    font-size: 13px;
}

#title_bar {
    position: relative;
    width: 100%;
    height: 3em;
}

#page_title {
    font-size: 22px;
    font-family: "Lato", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 400;
}

#page_subtitle {
    margin-bottom: 0.5em;
    font-size: 16px;
    font-weight: bold;
    text-align: center;
}

#home_module_list,
#office_module_list {
    position: relative;
    padding: 2em 0;
    text-align: center;
}

.module_item {
    min-width: 7em;
    display: inline-block;
    text-align: center;
}

.module_item a {
    display: block;
}

#config_wrapper {
    text-align: center;
}

#config_info {
    text-align: left;
}

#config_info .wide {
    width: 30%;
}

#integrations_header {
    margin: 10px 0;
    text-align: center;
    font-size: 1.4em;
    font-weight: normal;
    padding: 10px 0
}

#footer {
    margin-top: 5em;
    position: relative;
    text-align: center;
    font-size: 11px;
    color: #777777;
    clear: both;
}

a.rollover img {
    padding: 3px;
}

#filters.btn-group {
    vertical-align: none;
}

button.btn.dropdown-toggle.btn-sm {
    background-color: white;
    color: black;
    border: 2px solid #dce4ec;
}

.dropdown-menu {
    font-size: 13px;
}

.bootstrap-tagsinput {
    background-color: white;
    color: black;
    border: 2px solid #dce4ec;
    box-shadow: none;
}

label.required {
    color: red;
}

@media (min-width: 768px) {
    .navbar-nav>li>a {
        padding: 10px 10px 9px;
    }

    .modal-dlg .modal-dialog {
        width: 500px;
    }

    .modal-dlg-wide .modal-dialog {
        width: 750px;
    }
}

.modal-body {
    max-height: calc(100vh - 212px);
    overflow-y: auto;
}

.no-gutter [class*="-1"] {
    padding-right: 0;
    padding-left: 0;
}

/* Recreate font-monospace class from Bootstrap 5 */
.font-monospace {
    font-family: Menlo, Monaco, Consolas, "Courier New", monospace;
}


/* === Global Dropdown Fix for Dark Theme === */
.darkly select.form-control,
.darkly select.form-control option {
    color: #fff !important;
    background-color: #1a1a2e !important;
}

.darkly select.form-control:focus {
    color: #fff !important;
    background-color: #1a1a2e !important;
    border-color: #4ecca3 !important;
}

/* Dark theme specific overrides */
.darkly select.form-control,
.darkly select.form-control option {
    color: #fff !important;
    background-color: #1a1a2e !important;
}
/* FIX: Light Theme Dropdowns */
    background-color: #ffffff !important;
    color: #212529 !important;
    border-color: #ced4da !important;
}

/* Dark Theme ke liye bhi sahi karein */
body[class*="dark"] .form-control,
body[class*="dark"] select,
body[class*="dark"] .select2-container--default .select2-selection {
    background-color: #212529 !important;
    color: #f8f9fa !important;
    border-color: #373b3e !important;
}


/* Yeh rules sirf tab apply honge jab page dark ho (Flatly/Darkly) */
body {
    /* Default light theme colors */
    --input-bg: #ffffff;
    --input-text: #212529;
}

/* Agar body ka background dark hai (#1a1a2e ya similar), toh inputs bhi dark karo */
body[style*="background-color: #1a1a2e"] select,
body[style*="background-color: #1a1a2e"] input:not([type="checkbox"]):not([type="radio"]),
body[style*="background-color: #1a1a2e"] textarea {
    background-color: #1a1a2e !important;
    color: #ffffff !important;
    border-color: #4ecca3 !important;
}

/* Flatly theme ke liye specific (dark blue background) */
body[style*="background-color: #2c3e50"] select,
body[style*="background-color: #2c3e50"] input:not([type="checkbox"]):not([type="radio"]),
body[style*="background-color: #2c3e50"] textarea {
    background-color: #2c3e50 !important;
    color: #ffffff !important;
    border-color: #4ecca3 !important;
}


/* Dark Theme - Force inputs dark (body background se detect karo) */
/* Jab body ka background dark ho (#222222 ya #1a1a2e), inputs bhi dark karo */
body {
}

/* Agar body inline style mein dark hai */
body[style*="#222222"],
body[style*="#1a1a2e"],
body[style*="#2c3e50"] {
}

/* Sab inputs ko CSS variables se control karo */
.form-control,
select,
textarea,
input:not([type="checkbox"]):not([type="radio"]) {
    border-color: #4ecca3 !important;
}

/* Light theme ke liye explicit override */
.theme-light {
}

/* Dark Theme - Force inputs dark (body style ke through) */
body[style*="background-color: #1a1a2e"],
body[style*="background-color:#1a1a2e"],
body[style*="background-color: #222222"],
body[style*="background-color:#222222"],
body[style*="background-color: #2c3e50"],
body[style*="background-color:#2c3e50"] {
    /* Inputs ko dark karo */
    .form-control,
    select,
    textarea,
    input:not([type="checkbox"]):not([type="radio"]) {
        background-color: #1a1a2e !important;
        color: #ffffff !important;
        border-color: #4ecca3 !important;
    }
}

/* Darkly Theme - Inputs MUST be dark (override everything) */
body[style*="background-color: #222222"] .form-control,
body[style*="background-color: #222222"] select,
body[style*="background-color: #222222"] textarea,
body[style*="background-color: #222222"] input,
body[style*="background-color: #1a1a2e"] .form-control,
body[style*="background-color: #1a1a2e"] select,
body[style*="background-color: #1a1a2e"] textarea,
body[style*="background-color: #1a1a2e"] input {
    background-color: #1a1a2e !important;
    color: #ffffff !important;
    border-color: #4ecca3 !important;
}
/* DARK THEME - Inputs MUST be dark (highest specificity) */
body.darkly .form-control,
body.darkly select,
body.darkly textarea,
body.darkly input:not([type="checkbox"]):not([type="radio"]),
html body .darkly .form-control,
html body .darkly select,
html body .darkly textarea,
html body .darkly input:not([type="checkbox"]):not([type="radio"]) {
    background-color: #1a1a2e !important;
    color: #ffffff !important;
    border-color: #4ecca3 !important;
}

/* Light theme - inputs white */
.theme-light .form-control,
.theme-light select,
.theme-light textarea,
.theme-light input:not([type="checkbox"]):not([type="radio"]) {
    background-color: #ffffff !important;
    color: #212529 !important;
}

/* Dark Theme - Direct colors (no variables) */
body[style*="background-color: #222222"] .form-control,
body[style*="background-color: #222222"] select,
body[style*="background-color: #222222"] textarea,
body[style*="background-color: #222222"] input:not([type="checkbox"]):not([type="radio"]),
.darkly .form-control,
.darkly select,
.darkly textarea,
.darkly input:not([type="checkbox"]):not([type="radio"]) {
    background-color: #1a1a2e !important;
    color: #ffffff !important;
    border-color: #4ecca3 !important;
}

/* Light Theme - Direct colors */
.theme-light .form-control,
.theme-light select,
.theme-light textarea,
.theme-light input:not([type="checkbox"]):not([type="radio"]) {
    background-color: #ffffff !important;
    color: #212529 !important;
}
