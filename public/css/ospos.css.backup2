* {
    margin: 0;
    padding: 0;
}

html,
body {
    height: 100%;
}

a.none {
    text-decoration: none;
}

.topbar {
    color: #eee;
    font-size: 12px;
    background: #182735;
    padding: 0.2em;
}

/* Add container-xxl width from Bootstrap 5 */
@media (min-width: 1400px) {
    .container {
        width: 1320px;
    }
}

.navbar {
    border-radius: 0;
}

.tab-pane {
    padding-top: 10px;
}

.navbar-default .navbar-nav>.active>a,
.navbar-default .navbar-nav>.active>a:hover,
.navbar-default .navbar-nav>.active>a:focus {
    color: #2C3E50;
    background-color: #FFFFFF;
}

.jumbotron.push-spaces {
    margin: 0; /* Add this */
}

.navbar .menu-icon {
    text-align: center;
    font-size: 12px;
}

.navbar .menu-icon img {
    width: 24px;
}

.wrapper {
    font-size: 13px;
}

#title_bar {
    position: relative;
    width: 100%;
    height: 3em;
}

#page_title {
    font-size: 22px;
    font-family: "Lato", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 400;
}

#page_subtitle {
    margin-bottom: 0.5em;
    font-size: 16px;
    font-weight: bold;
    text-align: center;
}

#home_module_list,
#office_module_list {
    position: relative;
    padding: 2em 0;
    text-align: center;
}

.module_item {
    min-width: 7em;
    display: inline-block;
    text-align: center;
}

.module_item a {
    display: block;
}

#config_wrapper {
    text-align: center;
}

#config_info {
    text-align: left;
}

#config_info .wide {
    width: 30%;
}

#integrations_header {
    margin: 10px 0;
    text-align: center;
    font-size: 1.4em;
    font-weight: normal;
    padding: 10px 0
}

#footer {
    margin-top: 5em;
    position: relative;
    text-align: center;
    font-size: 11px;
    color: #777777;
    clear: both;
}

a.rollover img {
    padding: 3px;
}

#filters.btn-group {
    vertical-align: none;
}

button.btn.dropdown-toggle.btn-sm {
    background-color: white;
    color: black;
    border: 2px solid #dce4ec;
}

.dropdown-menu {
    font-size: 13px;
}

.bootstrap-tagsinput {
    background-color: white;
    color: black;
    border: 2px solid #dce4ec;
    box-shadow: none;
}

label.required {
    color: red;
}

@media (min-width: 768px) {
    .navbar-nav>li>a {
        padding: 10px 10px 9px;
    }

    .modal-dlg .modal-dialog {
        width: 500px;
    }

    .modal-dlg-wide .modal-dialog {
        width: 750px;
    }
}

.modal-body {
    max-height: calc(100vh - 212px);
    overflow-y: auto;
}

.no-gutter [class*="-1"] {
    padding-right: 0;
    padding-left: 0;
}

/* Recreate font-monospace class from Bootstrap 5 */
.font-monospace {
    font-family: Menlo, Monaco, Consolas, "Courier New", monospace;
}


/* === Global Dropdown Fix for Dark Theme === */
.darkly select.form-control,
.darkly select.form-control option {
    color: #fff !important;
    background-color: #1a1a2e !important;
}

.darkly select.form-control:focus {
    color: #fff !important;
    background-color: #1a1a2e !important;
    border-color: #4ecca3 !important;
}

/* Dark theme specific overrides */
.darkly select.form-control,
.darkly select.form-control option {
    color: #fff !important;
    background-color: #1a1a2e !important;
}
/* FIX: Light Theme Dropdowns */
body:not([class*="dark"]) .form-control,
body:not([class*="dark"]) select,
body:not([class*="dark"]) .select2-container--default .select2-selection {
    background-color: #ffffff !important;
    color: #212529 !important;
    border-color: #ced4da !important;
}

/* Dark Theme ke liye bhi sahi karein */
body[class*="dark"] .form-control,
body[class*="dark"] select,
body[class*="dark"] .select2-container--default .select2-selection {
    background-color: #212529 !important;
    color: #f8f9fa !important;
    border-color: #373b3e !important;
}

/* === FINAL BULLETPROOF DROPDOWN FIX === */
/* 1. DEFAULT (Light Theme) - Hamesha White rahega jab tak dark class na ho */
select.form-control, select, select.custom-select, select.bootstrap-select {
    background-color: #ffffff !important;
    color: #212529 !important;
    border-color: #ced4da !important;
    -webkit-text-fill-color: #212529 !important;
}
select.form-control option, select option {
    background-color: #ffffff !important;
    color: #212529 !important;
}

/* 2. DARK THEME OVERRIDE - Sirf tab apply hoga jab body par dark class hogi */
body.theme-dark select, body.theme-darkly select, body.darkly select,
body.theme-dark select.form-control, body.theme-darkly select.form-control, body.darkly select.form-control {
    background-color: #1a1a2e !important;
    color: #ffffff !important;
    border-color: #4ecca3 !important;
    -webkit-text-fill-color: #ffffff !important;
}
body.theme-dark select option, body.theme-darkly select option, body.darkly select option {
    background-color: #f8f9fa !important;
    color: #000000 !important;
}
/* ======================================== */

/* === FIX: Dropdown Options Visibility === */
/* Light Theme ke liye */
.bootstrap-select .dropdown-menu li a,
.select2-container .select2-results__option {
    color: #212529 !important;
    background-color: #ffffff !important;
}

/* Dark Theme ke liye */
.theme-dark .bootstrap-select .dropdown-menu li a,
.theme-dark .select2-container .select2-results__option {
    color: #ffffff !important;
    background-color: #1a1a2e !important;
}

/* === FIX: Flatly/Darkly Dark Themes === */
/* Yeh rules sirf tab apply honge jab page dark ho (Flatly/Darkly) */
body {
    /* Default light theme colors */
    --input-bg: #ffffff;
    --input-text: #212529;
}

/* Agar body ka background dark hai (#1a1a2e ya similar), toh inputs bhi dark karo */
body[style*="background-color: #1a1a2e"] select,
body[style*="background-color: #1a1a2e"] input:not([type="checkbox"]):not([type="radio"]),
body[style*="background-color: #1a1a2e"] textarea {
    background-color: #1a1a2e !important;
    color: #ffffff !important;
    border-color: #4ecca3 !important;
}

/* Flatly theme ke liye specific (dark blue background) */
body[style*="background-color: #2c3e50"] select,
body[style*="background-color: #2c3e50"] input:not([type="checkbox"]):not([type="radio"]),
body[style*="background-color: #2c3e50"] textarea {
    background-color: #2c3e50 !important;
    color: #ffffff !important;
    border-color: #4ecca3 !important;
}

/* === FIX: Flatly/Darkly Themes (No body class) === */
/* Flatly theme ka background #2c3e50 hota hai */
/* Darkly theme ka background #1a1a2e hota hai */

/* Jab body ka background dark ho, inputs ko bhi dark karo */
body {
    --input-bg-default: #ffffff;
    --input-text-default: #212529;
}

/* Flatly theme detection */
.bg-primary,
.navbar-default {
    background-color: #2c3e50 !important;
}

/* Inputs ko Flatly/Darkly theme ke saath match karo */
.form-control,
select,
textarea,
.input-group-addon {
    /* Light theme mein white, dark theme mein dark */
    background-color: var(--input-bg-default, #ffffff) !important;
    color: var(--input-text-default, #212529) !important;
}

/* Dark theme ke liye override */
.darkly .form-control,
.darkly select,
.darkly textarea,
.flatly .form-control,
.flatly select,
.flatly textarea {
    background-color: #1a1a2e !important;
    color: #ffffff !important;
    border-color: #4ecca3 !important;
}

/* Light Theme - Inputs White */
.theme-light .form-control,
.theme-light select,
.theme-light textarea {
    background-color: #ffffff !important;
    color: #212529 !important;
}

/* Dark Theme - Inputs Dark (Flatly/Darkly ka apna CSS use karein) */
/* Koi override nahi karenge */
